import numpy as np
import cv2

# Function to create image with colored boxes
def create_image(width, height):

    # Create white image
    image = np.ones((height, width, 3), dtype=np.uint8) * 255

    # Calculate box size (1/10th of image)
    box_width = width // 10
    box_height = height // 10

    # Black box - Top Left
    image[0:box_height, 0:box_width] = [0, 0, 0]

    # Blue box - Top Right
    image[0:box_height, width-box_width:width] = [255, 0, 0]

    # Green box - Bottom Left
    image[height-box_height:height, 0:box_width] = [0, 255, 0]

    # Red box - Bottom Right
    image[height-box_height:height, width-box_width:width] = [0, 0, 255]

    # Display image
    cv2.imshow("White Image with Four Colored Boxes", image)

    # Save image
    cv2.imwrite("colored_boxes.png", image)

    cv2.waitKey(0)
    cv2.destroyAllWindows()

# Get image size from user
width = int(input("Enter image width: "))
height = int(input("Enter image height: "))

# Call function
create_image(width, height)
