
import cv2
import numpy as np
import matplotlib.pyplot as plt

path = r"C:\Users\sruja\OneDrive\Desktop\lion.jpg"

img = cv2.imread(path)

if img is None:
    print("Image not found. Check the image path.")
else:
    rows, cols = img.shape[:2]

    # Four points in the original image
    pts1 = np.float32([
        [0, 0],
        [cols - 1, 0],
        [0, rows - 1],
        [cols - 1, rows - 1]
    ])

    # Four points in the transformed image
    pts2 = np.float32([
        [50, 50],
        [cols - 50, 0],
        [0, rows - 50],
        [cols - 50, rows - 50]
    ])

    # Calculate perspective transformation matrix
    matrix = cv2.getPerspectiveTransform(pts1, pts2)

    # Apply perspective transformation
    transformed = cv2.warpPerspective(img, matrix, (cols, rows))

    img_rgb = cv2.cvtColor(img, cv2.COLOR_BGR2RGB)
    transformed_rgb = cv2.cvtColor(transformed, cv2.COLOR_BGR2RGB)

    plt.subplot(1, 2, 1)
    plt.imshow(img_rgb)
    plt.title("Original Image")
    plt.axis("off")

    plt.subplot(1, 2, 2)
    plt.imshow(transformed_rgb)
    plt.title("Perspective Transformed")
    plt.axis("off")

    plt.show()

