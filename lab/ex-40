import cv2
import pytesseract

# Set Tesseract OCR path
pytesseract.pytesseract.tesseract_cmd = r"C:\Program Files\Tesseract-OCR\tesseract.exe"

# Video path
video_path = r"C:\Users\sruja\OneDrive\Desktop\16668267-uhd_2160_3840_24fps.mp4"

# Function to extract text from video
def extract_text(video_path):

    cap = cv2.VideoCapture(video_path)

    if not cap.isOpened():
        print("Error: Unable to open video")
        return

    print("Extracting text from video...\n")

    frame_count = 0

    while True:
        ret, frame = cap.read()

        if not ret:
            break

        frame_count += 1

        # Process every 30th frame
        if frame_count % 30 == 0:

            gray = cv2.cvtColor(frame, cv2.COLOR_BGR2GRAY)

            text = pytesseract.image_to_string(gray)

            if text.strip():
                print("Extracted Text:")
                print(text.strip())
                print("-------------------")

    cap.release()
    print("\nText extraction completed!")


# Function call
extract_text(video_path)
