import cv2

# Load the watch image
image_path = r"C:\Users\sruja\OneDrive\Desktop\watch.jpg"
image = cv2.imread(image_path)

if image is None:
    print("Error: Image not found. Check the file path.")
else:
    # Display the watch image
    cv2.imshow("Watch Recognition", image)

    print("Object Recognized: Watch")

    cv2.waitKey(0)
