import cv2
import matplotlib.pyplot as plt
import numpy as np
from PIL import Image
import pillow_avif

# Read AVIF image
image = Image.open(r"C:\Users\sruja\OneDrive\Desktop\lion.jpg.avif")

# Convert image to RGB
image = image.convert("RGB")
img = np.array(image)

print("Image loaded successfully!")

# Convert RGB image to grayscale
gray = cv2.cvtColor(img, cv2.COLOR_RGB2GRAY)

# Set threshold values
threshold_value = 127
max_value = 255

# Apply threshold segmentation
ret, segmented = cv2.threshold(
    gray, threshold_value, max_value, cv2.THRESH_BINARY
)

# Display results
plt.figure(figsize=(12, 5))

plt.subplot(1, 3, 1)
plt.imshow(img)
plt.title("Original Image")
plt.axis("off")

plt.subplot(1, 3, 2)
plt.imshow(gray, cmap="gray")
plt.title("Grayscale Image")
plt.axis("off")

plt.subplot(1, 3, 3)
plt.imshow(segmented, cmap="gray")
plt.title("Segmented Image")
plt.axis("off")

plt.tight_layout()
plt.show()

# Save segmented image
cv2.imwrite("segmented_lion.jpg", segmented)

print("Image segmentation completed successfully!")
