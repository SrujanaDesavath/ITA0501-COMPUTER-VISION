import numpy as np
import cv2

# Function to create a white image and draw rectangle
def create_rectangle(width, height):

    # Create white image
    image = np.ones((height, width, 3), dtype=np.uint8) * 255

    # Draw rectangle
    cv2.rectangle(image, (50, 50), (width-50, height-50),
                  (0, 0, 255), 3)

    # Display image
    cv2.imshow("Rectangle Image", image)

    # Save image
    cv2.imwrite("rectangle.png", image)

    cv2.waitKey(0)
    cv2.destroyAllWindows()

# Get image size from user
width = int(input("Enter image width: "))
height = int(input("Enter image height: "))

# Call function
create_rectangle(width, height)
