import cv2
import matplotlib.pyplot as plt

image_path = r"C:\Users\sruja\OneDrive\Desktop\lion.jpg"

image = cv2.imread(image_path)

if image is None:
    print("Image not found")
else:
    watermarked = image.copy()

    cv2.putText(
        watermarked,
        "COPYRIGHT",
        (30, 50),
        cv2.FONT_HERSHEY_SIMPLEX,
        1,
        (255, 255, 255),
        2
    )

    cv2.imwrite(
        r"C:\Users\sruja\OneDrive\Desktop\watermarked_image.jpg",
        watermarked
    )

    original = cv2.cvtColor(image, cv2.COLOR_BGR2RGB)
    result = cv2.cvtColor(watermarked, cv2.COLOR_BGR2RGB)

    plt.subplot(1, 2, 1)
    plt.imshow(original)
    plt.title("Original Image")
    plt.axis("off")

    plt.subplot(1, 2, 2)
    plt.imshow(result)
    plt.title("Watermarked Image")
    plt.axis("off")

    plt.show()

    print("Watermark added successfully!")
