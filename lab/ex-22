import cv2
import matplotlib.pyplot as plt

# Read the input image
image = cv2.imread(r"C:\Users\sruja\OneDrive\Desktop\lion.jpg")

if image is None:
    print("Error: Image not found. Check the file path.")
else:
    # Convert image to grayscale
    gray = cv2.cvtColor(image, cv2.COLOR_BGR2GRAY)

    # Convert grayscale image to binary
    ret, binary = cv2.threshold(
        gray, 127, 255, cv2.THRESH_BINARY
    )

    # Create a 3x3 kernel
    kernel = cv2.getStructuringElement(
        cv2.MORPH_RECT, (3, 3)
    )

    # Apply closing operation
    closing = cv2.morphologyEx(
        binary, cv2.MORPH_CLOSE, kernel
    )

    # Display original image
    plt.figure(figsize=(10, 5))

    plt.subplot(1, 3, 1)
    plt.imshow(cv2.cvtColor(image, cv2.COLOR_BGR2RGB))
    plt.title("Original Image")
    plt.axis("off")

    # Display binary image
    plt.subplot(1, 3, 2)
    plt.imshow(binary, cmap="gray")
    plt.title("Binary Image")
    plt.axis("off")

    # Display closing image
    plt.subplot(1, 3, 3)
    plt.imshow(closing, cmap="gray")
    plt.title("Closing Image")
    plt.axis("off")

    plt.tight_layout()
    plt.show()

    # Save the output image
    cv2.imwrite(
        r"C:\Users\sruja\OneDrive\Desktop\closing_output.jpg",
        closing
    )

    print("Closing operation completed successfully!")
    print("Output saved as closing_output.jpg")

