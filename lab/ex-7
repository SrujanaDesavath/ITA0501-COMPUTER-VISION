
import cv2
import os

path = r"C:\Users\sruja\OneDrive\Desktop\video.mp4.mp4"

print("File exists:", os.path.exists(path))

cap = cv2.VideoCapture(path)

if cap.isOpened():
    print("Video opened successfully!")

    fps = cap.get(cv2.CAP_PROP_FPS)
    print("FPS:", fps)

    ret, frame = cap.read()

    if ret:
        print("Video frame read successfully!")
        cv2.imshow("My Video", frame)
        cv2.waitKey(0)
        cv2.destroyAllWindows()
    else:
        print("Cannot read video frames.")

else:
    print("OpenCV cannot open the video.")

cap.release()

