import cv2

# Input video path
input_path = r"C:\Users\sruja\OneDrive\Desktop\video.mp4.mp4"

# Output video path
output_path = r"C:\Users\sruja\OneDrive\Desktop\reverse_video.mp4"

# Open the video
cap = cv2.VideoCapture(input_path)

if not cap.isOpened():
    print("Error: Cannot open the video.")
else:
    frames = []

    # Read all frames
    while True:
        ret, frame = cap.read()

        if not ret:
            break

        frames.append(frame)

    cap.release()

    if len(frames) == 0:
        print("Error: No frames found.")
    else:
        # Get video properties
        height, width = frames[0].shape[:2]
        fps = 20

        # Create output video writer
        fourcc = cv2.VideoWriter_fourcc(*"mp4v")

        out = cv2.VideoWriter(
            output_path,
            fourcc,
            fps,
            (width, height)
        )

        # Write frames in reverse order
        for frame in reversed(frames):
            out.write(frame)

        out.release()

        print("Video reversed successfully!")
        print("Output saved at:", output_path)

        # Play the reversed video
        cap = cv2.VideoCapture(output_path)

        while cap.isOpened():
            ret, frame = cap.read()

            if not ret:
                break

            cv2.imshow("Reverse Video", frame)

            if cv2.waitKey(30) & 0xFF == ord("q"):
                break

        cap.release()
        cv2.destroyAllWindows()
