import numpy as np
import cv2

# Function to create a white image and draw circle
def create_circle(width, height):

    # Create white image
    image = np.ones((height, width, 3), dtype=np.uint8) * 255

    # Calculate center and radius
    center = (width // 2, height // 2)
    radius = min(width, height) // 4

    # Draw circle
    cv2.circle(image, center, radius, (0, 0, 255), 3)

    # Display image
    cv2.imshow("Circle Image", image)

    # Save image
    cv2.imwrite("circle.png", image)

    cv2.waitKey(0)
    cv2.destroyAllWindows()

# Get image size from user
width = int(input("Enter image width: "))
height = int(input("Enter image height: "))

# Call function
create_circle(width, height)
