import cv2
import matplotlib.pyplot as plt

path = r"C:\Users\sruja\OneDrive\Desktop\lion.jpg"

img = cv2.imread(path)

if img is None:
   print("Image not found. Check the image path.")
else:
   bigger = cv2.resize(img, None, fx=2, fy=2)
   smaller = cv2.resize(img, None, fx=0.5, fy=0.5)


img_rgb = cv2.cvtColor(img, cv2.COLOR_BGR2RGB)
bigger_rgb = cv2.cvtColor(bigger, cv2.COLOR_BGR2RGB)
smaller_rgb = cv2.cvtColor(smaller, cv2.COLOR_BGR2RGB)

plt.figure(figsize=(12, 5))

plt.subplot(1, 3, 1)
plt.imshow(img_rgb)
plt.title("Original Image")
plt.axis("off")

plt.subplot(1, 3, 2)
plt.imshow(bigger_rgb)
plt.title("Bigger Image")
plt.axis("off")

plt.subplot(1, 3, 3)
plt.imshow(smaller_rgb)
plt.title("Smaller Image")
plt.axis("off")

plt.tight_layout()
plt.show()

